# 배포 서버(EC2)의 /opt/aifilm/.env 예시. 실제 값은 서버에만 두고 git에 올리지 않는다.
# 권한은 sudo chmod 600 /opt/aifilm/.env 로 root만 읽게 한다.

# 띄울 이미지. 태그는 배포할 커밋의 짧은 해시(git rev-parse --short HEAD)다.
APP_IMAGE=<계정ID>.dkr.ecr.ap-northeast-2.amazonaws.com/aifilm-app:<커밋 해시>

# RDS 접속 정보. 마스터 계정이 아니라 앱 전용 사용자를 쓴다.
DB_HOST=<RDS 엔드포인트>
DB_PORT=3306
DB_NAME=aifilm
DB_USERNAME=aifilm
DB_PASSWORD=<앱 전용 사용자 비밀번호>

# 브라우저에서 API를 호출할 프론트 출처. 여러 개면 쉼표로 구분한다. (예: https://aifilm.life)
# 비워 두면 다른 출처의 브라우저 요청을 허용하지 않는다.
AIFILM_CORS_ALLOWED_ORIGINS=
