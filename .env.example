# 로컬 개발용 MySQL(Docker) 접속 정보
#
# 사용법:
#   1) 이 파일을 저장소 루트에 .env 파일로 복사한다.
#   2) 값은 로컬 개발용이므로 아래 예시 그대로 써도 되고, 원하면 바꿔도 된다.
#   3) .env는 .gitignore에 등록되어 있어 git에 절대 올라가지 않는다.
#
# docker-compose.yml과 application.yml에서는 여기 있는 변수명을 그대로 참조한다.

# 앱이 접속할 MySQL 주소. docker compose는 DB_PORT로 MySQL 포트를 연다.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aifilm
DB_USERNAME=aifilm
DB_PASSWORD=0000
DB_ROOT_PASSWORD=0000
