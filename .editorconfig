root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,gradle}]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 120
ij_continuation_indent_size = 8

[*.java]
# static import 전부 → 빈 줄 → 나머지 import 전부
ij_java_imports_layout = $*,|,*
# 와일드카드 import를 쓰지 않는다
ij_java_class_count_to_use_import_on_demand = 999
ij_java_names_count_to_use_import_on_demand = 999
# 여러 줄로 나눈 매개변수 등을 괄호 위치에 맞춰 정렬하지 않는다
ij_java_align_multiline_parameters = false
ij_java_align_multiline_resources = false
ij_java_align_multiline_records = false
ij_java_align_multiline_for = false

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# 운영에 적용된 migration은 내용이 바뀌면 Flyway 체크섬 검증에 걸린다
[*.sql]
trim_trailing_whitespace = unset
insert_final_newline = unset

# 외부 dist 원본
[api/src/main/resources/static/swagger-ui/**]
charset = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
